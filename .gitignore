# Ignore the vendor directory (Composer handles this)
/vendor/

# Ignore Drupal's site-specific files and settings
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml
/web/sites/*/files/

# Ignore DDEV configuration (optional, but common)
.ddev/

# Ignore environment variables and sensitive keys
.env

# Ignore IDE-specific files (VS Code, etc.)
.vscode/

# Ignore OS-generated files
.DS_Store
Thumbs.db